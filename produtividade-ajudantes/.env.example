# Copie para .env e ajuste
PORT=3100
NODE_ENV=development
# Obrigatório em produção (use um valor longo e aleatório)
JWT_SECRET=
JWT_EXPIRES_IN=10h
APP_TZ=America/Sao_Paulo
DB_PATH=./data/logiponto.db
# Chave para a API de integração com o TMS/ERP (vazio = integração desabilitada)
INTEGRATION_API_KEY=
OPERATOR_CANCEL_WINDOW_MIN=10
MIN_SECONDS_FOR_RATE=300
