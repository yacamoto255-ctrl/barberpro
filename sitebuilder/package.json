{
  "name": "versal-sitebuilder",
  "version": "1.0.0",
  "private": true,
  "description": "Versal Estúdio — gerador de sites com agendamento online para qualquer tipo de negócio",
  "main": "server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:e2e": "node scripts/e2e.js",
    "loadtest": "node scripts/loadtest.js",
    "reset-password": "node scripts/reset-password.js",
    "seed-site": "node scripts/seed-site.js",
    "seed-demos": "node scripts/seed-site.js sites/demos --update"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 20000,
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "jest": "^29.7.0",
    "playwright-core": "^1.63.0",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
