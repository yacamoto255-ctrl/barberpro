# Copie para .env e ajuste. Nenhuma variável é obrigatória para rodar localmente.

# Porta do servidor
PORT=3000

# Banco SQLite e backups (em produção, aponte para um volume persistente)
DB_PATH=./data/sitebuilder.db
BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Segurança — em produção defina um segredo longo (64+ caracteres aleatórios)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duração da sessão no painel
TOKEN_TTL=8h
# Se definido, o primeiro acesso (criar admin) exige este código
SETUP_TOKEN=

# Endereço público usado nos links de cancelamento e de redefinição de senha
PUBLIC_BASE_URL=https://sites.seudominio.com.br

# IA (Claude) — opcional; também pode ser cadastrada no painel em Configurações
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# Fuso horário dos negócios
BUSINESS_TZ=America/Sao_Paulo

# Limites de requisições por IP (0 desliga)
RATE_LIMIT_LOGIN=20
RATE_LIMIT_PUBLIC_WRITE=15
RATE_LIMIT_PUBLIC_READ=300
RATE_LIMIT_AI=10
