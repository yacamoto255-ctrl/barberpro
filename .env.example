# Copie para .env e preencha os valores

# OBRIGATÓRIO em produção
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-segura-de-64-chars

# Railway define PORT automaticamente
PORT=3000

NODE_ENV=production

# Domínio do seu frontend na Netlify
# Ex: ALLOWED_ORIGINS=https://meu-barberpro.netlify.app
ALLOWED_ORIGINS=*
